# .env.example — 로컬 실값은 같은 경로 .env.local 에 작성 (gitignored)
# 서버 전용 변수가 기본(NEXT_PUBLIC_ prefix 없음, 브라우저 번들 노출 금지) — 단 아래 basePath는
# 예외다. 값 자체가 공개돼도 안전한 경로 문자열이고, Next.js가 basePath 판단에 클라 번들을
# 요구해(next.config.ts) 빌드타임 인라인이 불가피하다(런타임 주입 불가 — 값은 빌드 시점 확정).
NEXT_PUBLIC_BASE_PATH=/app

# auth(OIDC 인가 서버) 통합 계약 — auth application.yml 기본값과 byte 일치해야 PKCE 교환 성공
AUTH_ISSUER=http://localhost:30000
AUTH_CLIENT_ID=morymaker-web
AUTH_CLIENT_SECRET=dev-secret
# basePath(/app)가 콜백 경로에도 포함된다 — 위 NEXT_PUBLIC_BASE_PATH와 동일 경계에서 접두.
# e2e(playwright webServer)는 PW_PORT=3100 고정 포트로 뜨므로 .env.local에서 이 값을
# http://localhost:3100/app/oauth/callback 로 오버라이드해야 한다(auth DB redirect_uris에도 등록 필요).
AUTH_REDIRECT_URI=http://localhost:3000/app/oauth/callback

# mm_auth 쿠키 HMAC 서명 시크릿 — 32자 이상 랜덤 문자열 (fail-closed: 비어있으면 로그인 불가)
AUTH_HMAC_SECRET=

# api(Resource Server) BFF 프록시 업스트림 — host root(경로 접미사 없음, 3분법이 /api/... 절대경로로 판정)
API_BASE_URL=http://localhost:30100

# auth 서버(계정 어드민 등) BFF 프록시 업스트림 — host root. api와 별도 서버(30000)라 별도 env 필요
# (AUTH_ISSUER는 OIDC issuer 의미라 겸용 시 계약 혼선 — api/accounts* 요청만 이 base로 분기된다)
AUTH_API_BASE_URL=http://localhost:30000
