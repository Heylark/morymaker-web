# .env.example — 로컬 실값은 같은 경로 .env.local 에 작성 (gitignored)
# 서버 전용 변수만 — NEXT_PUBLIC_ prefix 없음(브라우저 번들 노출 금지)

# auth(OIDC 인가 서버) 통합 계약 — auth application.yml 기본값과 byte 일치해야 PKCE 교환 성공
AUTH_ISSUER=http://localhost:30000
AUTH_CLIENT_ID=morymaker-web
AUTH_CLIENT_SECRET=dev-secret
AUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# mm_auth 쿠키 HMAC 서명 시크릿 — 32자 이상 랜덤 문자열 (fail-closed: 비어있으면 로그인 불가)
AUTH_HMAC_SECRET=

# api(Resource Server) BFF 프록시 업스트림 — host root(경로 접미사 없음, 3분법이 /api/... 절대경로로 판정)
API_BASE_URL=http://localhost:30100
